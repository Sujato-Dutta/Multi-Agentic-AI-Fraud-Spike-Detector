# ==============================================================================
# ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   Copy-Item .env.example .env
#
# Setup guide:
#   1. REQUIRED: replace every "replace-with-..." value below.
#   2. OPTIONAL: fill blank values only when enabling those integrations.
#   3. PRECONFIGURED: the remaining values already work for local development.

# ==============================================================================
# REQUIRED — REPLACE THESE VALUES
# ==============================================================================

# Application secrets
JWT_SECRET_KEY=replace-with-a-random-local-secret
SERVICE_TOKEN=replace-with-a-random-service-token

# Demo account passwords
DEMO_ANALYST_PASSWORD=replace-with-analyst-password
DEMO_LEAD_ANALYST_PASSWORD=replace-with-lead-password
DEMO_ADMIN_PASSWORD=replace-with-admin-password

# ==============================================================================
# OPTIONAL — LEAVE BLANK UNLESS YOU NEED THE INTEGRATION
# ==============================================================================

# Gemini enables live LLM-generated investigation narratives.
# The application uses deterministic fallbacks when this is blank.
GEMINI_API_KEY=

# Set this only when checkpoints should use a dedicated database URL.
CHECKPOINT_DATABASE_URL=

# Required only when LANGSMITH_TRACING is changed to true.
LANGSMITH_API_KEY=

# ==============================================================================
# PRECONFIGURED — LOCAL DEVELOPMENT DEFAULTS
# ==============================================================================

# Application runtime
APP_ENV=development
LOG_LEVEL=INFO

# Local data, model, and report locations
DATA_DIR=data
MODEL_DIR=models
REPORT_DIR=reports
FRONTEND_DIR=frontend
HELDOUT_REPORT_PATH=reports/heldout_test/results.json

# MLflow and fraud-model artifacts
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
FRAUD_PRIMARY_MODEL_PATH=models/fraud/fraud_model.joblib
FRAUD_FALLBACK_MODEL_PATH=models/fraud/isolation_forest.joblib

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://fraud:fraud@localhost:5432/fraud_detector
DATABASE_AUTO_CREATE=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication behavior and demo usernames
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
DEMO_ANALYST_USERNAME=analyst
DEMO_LEAD_ANALYST_USERNAME=lead_analyst
DEMO_ADMIN_USERNAME=admin

# Redis cache
REDIS_URL=redis://localhost:6379/0
CACHE_MAX_ENTRIES=10000
CACHE_DEFAULT_TTL_SECONDS=300

# Redpanda connection and consumer behavior
REDPANDA_BOOTSTRAP_SERVERS=localhost:19092
REDPANDA_CLIENT_ID=fraud-detector
REDPANDA_CONSUMER_GROUP=fraud-detector-v1
REDPANDA_AUTO_OFFSET_RESET=earliest

# Redpanda topic names
TOPIC_TRANSACTIONS=transactions
TOPIC_FRAUD_SCORES=fraud_scores
TOPIC_SPIKE_ALERTS=spike_alerts
TOPIC_INCIDENTS=incidents
TOPIC_AGENT_EVENTS=agent_events
TOPIC_ANALYST_ACTIONS=analyst_actions
TOPIC_RESPONSES=responses
TOPIC_OUTCOMES=outcomes
TOPIC_REWARDS=rewards
TOPIC_ALERTS=alerts

# Stream consumer
STREAM_CONSUMER_ENABLED=true
STREAM_MAX_POLL_RECORDS=500
STREAM_POLL_TIMEOUT_MS=1000

# Durable outbox dispatcher
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_SECONDS=1.0
OUTBOX_PUBLISH_TIMEOUT_SECONDS=15.0
OUTBOX_CYCLE_RETRY_MAX_SECONDS=60.0
OUTBOX_CYCLE_LOG_INTERVAL_SECONDS=60.0

# Transaction ingestion and exposure calculation
MAX_INGEST_BATCH_SIZE=1000
EXPOSURE_LOSS_FACTOR=1.0

# Gemini model selection
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_SECONDARY_MODEL=gemini-3.1-flash-lite
GEMINI_ECONOMY_MODEL=gemma-4-31b-it

# LLM reliability and caching
LLM_TIMEOUT_SECONDS=12
LLM_MAX_ATTEMPTS=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=60
LLM_CACHE_TTL_SECONDS=900

# Optional LLM cost metadata; zero disables cost estimation.
LLM_PRIMARY_INPUT_COST_PER_MILLION=0
LLM_PRIMARY_OUTPUT_COST_PER_MILLION=0
LLM_SECONDARY_INPUT_COST_PER_MILLION=0
LLM_SECONDARY_OUTPUT_COST_PER_MILLION=0
LLM_ECONOMY_INPUT_COST_PER_MILLION=0
LLM_ECONOMY_OUTPUT_COST_PER_MILLION=0

# Investigation behavior
INVESTIGATION_FALSE_POSITIVE_COST_INR=40
INVESTIGATION_AUTO_START=true

# LangSmith tracing defaults
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=fraud-spike-detector-development

# Policies, stream monitoring, and drift detection
POLICY_PATH=infrastructure/policies.yaml
STREAM_LAG_ALERT_THRESHOLD=1000
DRIFT_PSI_ALERT_THRESHOLD=0.20
DRIFT_PSI_BUCKETS=10
DRIFT_WINDOW_TRANSACTIONS=2000

# Reward calculation and action assumptions
ACTION_EFFECTS_PATH=infrastructure/action_effects.yaml
REWARD_ALPHA=1.0
REWARD_BETA=1.0
REWARD_GAMMA=1.0
REWARD_DELTA=1.0
REWARD_MODEL_PATH=models/reward/reward_model.joblib

# Response-policy artifacts and promotion gates
PRODUCTION_POLICY_PATH=models/policy/production_policy.joblib
CANDIDATE_POLICY_PATH=models/policy/candidate_policy.joblib
POLICY_HOLDBACK_FRACTION=0.30
POLICY_REWARD_MARGIN_INR=0
POLICY_RECALL_TOLERANCE=0.02
POLICY_FP_COST_TOLERANCE=0.05

# Reward model and LinUCB training
REWARD_MODEL_ESTIMATORS=200
LINUCB_ALPHA=0.25
